// =============================================================================
//           NIRI 现代实验室配置 (基于 i3wm 习惯 & Cell 布局)
// =============================================================================

input {
    keyboard {
        xkb {
            layout "cell" // 保持您的 CELL 布局 [cite: 1]
        }
        repeat-delay 250 // [cite: 2]
        repeat-rate 40   // [cite: 2]
    }
}

layout {
    default-column-width { proportion 1.0; } // 保持您要求的 100% 宽度 [cite: 3]
    center-focused-column "always"           // 保持焦点居中 [cite: 3]
    gaps 1                                   // 参照 i3 配置：gaps inner 1px [cite: 24]

    focus-ring {
        width 2
        active-color "#7aa2f7"
        inactive-color "#414868"
    }
}

animations {
    slowdown 1.1
}

window-rule {
    // match { is-floating false; } // [cite: 4]
    default-column-width { proportion 0.9; }
}

binds {
    // --- 1. 核心导航 (保持物理位置习惯) ---
    Mod+Tab { spawn "rofi" "-show" "window"; }
    // Mod+Tab { focus-window-previous; } // 您要求的跳转记忆功能 [cite: 6]
    Mod+H { focus-column-left; }  // [cite: 5, 27]
    Mod+L { focus-column-right; } // [cite: 27]
    Mod+Left  { focus-column-left; }  // [cite: 5, 27]
    Mod+Right { focus-column-right; } // [cite: 27]

    // 使用 Mod + J/K 实现工作区的前后切换
    Mod+J { focus-workspace-down; }
    Mod+K { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }
    Mod+Up   { focus-workspace-up; }

    // --- 2. 应用程序启动 (参照 i3wm 映射) ---
    // i3wm: $mod+Return 聚焦/启动终端
    Mod+Return { spawn "alacritty"; } // 对应 i3 的 $terminal_launcher [cite: 22]

    // i3wm: $mod+space 聚焦/启动浏览器
    Mod+Space { spawn "firefox"; } // 对应 i3 的 $browser_launcher [cite: 22]

    // i3wm: $mod+Escape 聚焦/启动编辑器
    Mod+Escape { spawn "emacs"; } // 对应 i3 的 $editor_launcher [cite: 22]

    // i3wm: $mod+BackSpace 聚焦/启动文件管理器
    Mod+BackSpace { spawn "nemo"; } // 对应 i3 的 $filer_launcher [cite: 22]

    // 应用启动器 (对应 i3 的 $mod+x Rofi)
    Mod+X { spawn "rofi" "-modi" "drun,run" "-show" "run"; }

    // --- 3. 工作区管理 (移植 i3 的 n/i/o/u 逻辑) ---
    // i3wm: $mod+n/i/o/u 切换到工作区 1/2/3/4
    Mod+N { focus-workspace 1; }
    Mod+I { focus-workspace 2; }
    Mod+O { focus-workspace 3; }
    Mod+U { focus-workspace 4; }

    // i3wm: $moS+n/i/o/u 移动窗口到工作区 1/2/3/4
    Mod+Shift+N { move-column-to-workspace 1; }
    Mod+Shift+I { move-column-to-workspace 2; }
    Mod+Shift+O { move-column-to-workspace 3; }
    Mod+Shift+U { move-column-to-workspace 4; }

    // --- 4. 窗口管理 ---
    Mod+Shift+C { close-window; } // 对应 i3 的 $moS+c kill [cite: 29]
    Mod+Z { maximize-column; }    // 对应 i3 的 $mod+e 全屏切换 [cite: 28]
    Mod+V { toggle-window-floating; } // 对应 i3 的 $mod+f 浮动切换 [cite: 28]

    // 移动全屏窗口在轨道上的顺序 [cite: 7]
    Mod+Shift+H { consume-or-expel-window-left; }
    Mod+Shift+L { consume-or-expel-window-right; }
    Mod+Shift+Left  { consume-or-expel-window-left; }
    Mod+Shift+Right { consume-or-expel-window-right; }

    // 如果您想在移动的同时把当前窗口也带到新工作区：
    Mod+Shift+J { move-column-to-workspace-down; }
    Mod+Shift+K { move-column-to-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }
    Mod+Shift+Up   { move-column-to-workspace-up; }

    // --- 5. 系统控制 (参照 i3wm 映射) --- 音量与亮度控制 [cite: 25, 26]
    XF86AudioRaiseVolume { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "+3%"; }
    XF86AudioLowerVolume { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "-3%"; }
    XF86AudioMute        { spawn "pactl" "set-sink-mute"   "@DEFAULT_SINK@" "toggle"; }
    XF86MonBrightnessUp   { spawn "brightnessctl" "set" "3%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "3%-"; }

    // 截图 (对应 i3 的 Print)
    Print { screenshot; }

    // 锁屏与休眠 (对应 i3 的 $moC+grave) [cite: 22, 44]
    Mod+Ctrl+Grave { spawn "swaylock" "-c" "000000"; }
    // Mod+Ctrl+Shift+Grave { spawn "systemctl" "suspend"; } // 休眠
    // Mod+Ctrl+Shift+Grave { spawn "niri" "msg" "action" "quit"; } // 退出

    // 重载配置 [cite: 14]
    Mod+Shift+R { spawn "niri" "msg" "action" "do-screen-transition" "---" "reload-config"; }
}

// 启动项 [cite: 15]
spawn-at-startup "waybar"  // 替代 i3bar [cite: 45]
spawn-at-startup "fcitx-autostart" // 输入法
spawn-at-startup "nm-applet" // 网络图标 [cite: 25]
spawn-at-startup "pamac-tray"
spawn-at-startup "xfce4-clipman"
spawn-at-startup "xfce4-power-manager"
spawn-at-startup "blueman-applet"
spawn-at-startup "volumeicon"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
// spawn-at-startup "xrandr --output eDP-1 --mode 1920x1200 --rate 60"
// spawn-at-startup "nitrogen --restore"
spawn-at-startup "xfsettingsd"
spawn-at-startup "systemctl xfce4-notifyd.service"
spawn-at-startup "/opt/v2rayN-linux-64.AppImage"

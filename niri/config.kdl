// =============================================================================
//           NIRI 现代实验室配置 (基于 i3wm 习惯 & Cell 布局)
// =============================================================================

// Refs::
// https://github.com/niri-wm/niri/blob/main/resources/default-config.kdl
// https://github.com/niri-wm/niri/wiki/Configuration:-Key-Bindings

input {
    // move mouse point the center of the target window
    warp-mouse-to-focus mode="center-xy-always" // 鼠标自动居中
    focus-follows-mouse // 💡

    keyboard {
        xkb {
            layout "cell" // 保持您的 CELL 布局
        }
        repeat-delay 250
        repeat-rate 40
    }
}

layout {
    default-column-width { proportion 1.0; } // 保持要求的 100% 宽度
    // center-focused-column "on-overflow"      // 保持焦点居中
    center-focused-column "never"      // 保持焦点居中
    always-center-single-column

    gaps 10                                  // 参照 i3 配置: gaps inner 1px

    preset-column-widths {
        proportion 0.35 // 0.3
        proportion 0.65 // 0.6
        // proportion 0.9
    }

    focus-ring {
        width 5
        active-color "#644264" // active-gradient from="#9f3e04" to="#9f6717" angle=45
        inactive-color "#2f2a24"
    }
}

animations {
    slowdown 1.1
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
    default-column-width { proportion 1.0; }
}

recent-windows {
    // off
    debounce-ms 750
    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        padding 30
        corner-radius 0
    }

    previews {
        max-height 480
        max-scale 0.5
    }

    binds {
        Mod+Tab         { next-window scope="workspace"; }
        Mod+Shift+Tab   { previous-window scope="workspace"; }

        Alt+Tab         { next-window     scope="all"; }
        Alt+Shift+Tab   { previous-window scope="all"; }
        Alt+grave       { previous-window filter="app-id"; }
        Alt+Shift+grave { next-window     filter="app-id"; }
    }
}

binds {
    // --- 1. 核心导航 (保持物理位置习惯) ---
    // show the Overview: a zoomed-out view of workspaces and windows.
    // You can also move the mouse into the top-left hot corner,
    // or do a four-finger swipe up on a touchpad.
    Mod+grave { toggle-overview; }
    Mod+Shift+grave { toggle-overview; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }

    // 使用 Mod + J/K 实现工作区的前后切换
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+Up   { focus-window-or-workspace-up; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    Mod+Page_Down { focus-window-down; }
    Mod+Page_Up   { focus-window-up; }
    Mod+Shift+Page_Down { move-window-down; }
    Mod+Shift+Page_Up   { move-window-up; }

    // --- 2. 应用程序启动 (参照 i3wm 映射) ---
    Mod+Return cooldown-ms=300 { spawn "ghostty"; }
    Mod+T cooldown-ms=300 { spawn "ghostty"; }

    Mod+Space cooldown-ms=300 { spawn "firefox"; }
    Mod+W cooldown-ms=300 { spawn "firefox"; }

    Mod+Escape cooldown-ms=300 { spawn "neovide"; }
    Mod+E cooldown-ms=300 { spawn "neovide"; }

    Mod+BackSpace cooldown-ms=300 { spawn "nemo"; }
    Mod+F cooldown-ms=300 { spawn "nemo"; }

    Mod+D cooldown-ms=300 { spawn "zathura"; }

    // 应用启动器
    Mod+X repeat=false { spawn "xfce4-appfinder"; }

    // --- 3. 工作区管理 (移植 i3 的 n/i/o/u 逻辑) ---
    Mod+N { focus-workspace 1; }
    Mod+I { focus-workspace 2; }
    Mod+O { focus-workspace 3; }
    Mod+U { focus-workspace 4; }

    Mod+Shift+N { move-column-to-workspace 1; }
    Mod+Shift+I { move-column-to-workspace 2; }
    Mod+Shift+O { move-column-to-workspace 3; }
    Mod+Shift+U { move-column-to-workspace 4; }

    // --- 4. 窗口管理 ---
    Mod+Shift+C cooldown-ms=300 { close-window; }
    Mod+Z { maximize-column; }
    Mod+V cooldown-ms=300 { switch-preset-column-width; }

    Mod+Shift+H { consume-or-expel-window-left; }
    Mod+Shift+L { consume-or-expel-window-right; }
    Mod+Shift+Left  { consume-or-expel-window-left; }
    Mod+Shift+Right { consume-or-expel-window-right; }

    Mod+Shift+J { move-column-to-workspace-down; }
    Mod+Shift+K { move-column-to-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }
    Mod+Shift+Up   { move-column-to-workspace-up; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Finer height adjustments when in column with other windows.
    Mod+Minus { set-window-height "-15%"; }
    Mod+Equal { set-window-height "+15%"; }
    Mod+BracketLeft { set-column-width "-15%"; }
    Mod+BracketRight { set-column-width "+15%"; }

    // --- 5. 系统控制 --- 音量与亮度控制
    XF86AudioRaiseVolume { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "+3%"; }
    XF86AudioLowerVolume { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "-3%"; }
    XF86AudioMute        { spawn "pactl" "set-sink-mute"   "@DEFAULT_SINK@" "toggle"; }
    XF86MonBrightnessUp   { spawn "brightnessctl" "set" "3%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "3%-"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // 锁屏与休眠
    // Mod+Ctrl+1 { spawn "gtklock"; } // { spawn "bash" "-c" "power-off-monitors && gtklock"; } // swaylock" "-c" "000000"; }
    Mod+Ctrl+1 { spawn "sh" "-c" "gtklock & sleep 0.1 && niri msg action power-off-monitors"; } // Backslash
    Mod+Ctrl+Shift+1 { spawn "systemctl" "suspend"; }

    // 重载配置
    Mod+Ctrl+R { spawn "niri" "msg" "action" "do-screen-transition" "---" "reload-config"; }
    Mod+Ctrl+Q { quit; }

    // preview the list of important hotkeys.
    Mod+P { show-hotkey-overlay; }

    Mod+S repeat=false { focus-window-previous; }

    // fast close by mouse
    Mod+MouseMiddle repeat=false { close-window; }
}

screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H-%M-%S.png"

// =============================================================================
//                               启动项 (Autostart)
// =============================================================================

// 1. 初始化核心环境 (注入核心变量，但不强制 IM_MODULE 以遵循 Wayland 原生协议)
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "DISPLAY"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// 2. UI 组件
spawn-at-startup "waybar"
spawn-at-startup "mako" // Notification Daemon
// spawn-at-startup "xfsettingsd" // 如果没有特定 GTK 主题同步问题，建议注释掉以减少冲突

// 3. 核心应用托盘 (Fcitx5 建议在后台运行)
spawn-at-startup "fcitx5" "-d" "--replace"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"
spawn-at-startup "pamac-tray"

// 4. 电量管理 (使用 --no-daemon 模式并置于 dbus 启动后)
spawn-at-startup "xfce4-power-manager" "--no-daemon"

// 5. 设置屏幕分辨率
spawn-at-startup "xrandr" "--output" "eDP-1" "--mode" "1920x1200" "--rate" "60"

// 备选/注释项
// spawn-at-startup "volumeicon" // 建议通过 waybar pulseaudio 模块替代
// spawn-at-startup "swww-daemon" // 如需动态壁纸可启用


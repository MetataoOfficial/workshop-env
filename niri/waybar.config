/**
 * Waybar 配置 - 琥珀色悬浮圆角版
 * 适配 niri 滚动窗口管理器
 */
{
    "layer": "top",      // 置于顶层
    "position": "top",   // 靠上显示
    "height": 36,        // 高度稍微增加以适应圆角

    // 设置边距，创造悬浮感
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    // 模块排列
    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "tray"
    ],

    // 左侧模块：工作区
    "niri/workspaces": {
        "format": "{index}",
        "all-outputs": true,
        "on-click": "activate"
    },

    // 左侧模块：当前窗口标题
    "niri/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },

    // 中间模块：时间、日期、星期
    "clock": {
        // 格式：󱑂 时:分 | 月/日 星期 (中文环境自动显示中文)
        "format": "󱑂 {:%H:%M  |  %m月%d日 %a}",
        "format-alt": "󰃭 {:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffc777'><b>{}</b></span>",
                "days": "<span color='#a9b1d6'>{}</span>",
                "weekdays": "<span color='#ff9e64'><b>{}</b></span>",
                "today": "<span color='#1a1b26' background='#ff9e64'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode"
        }
    },

    // 右侧模块：音频
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 静音",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    // 右侧模块：网络
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 有线",
        "format-linked": "{ifname} (无IP)",
        "format-disconnected": "󰤭 断开",
        "tooltip-format-wifi": "{ipaddr} | 信号: {signaldBm}dBm"
    },

    // 右侧模块：电池
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    // 右侧模块：系统托盘
    "tray": {
        "icon-size": 18,
        "spacing": 10
    }
}
